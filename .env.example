# Required: existing dedicated absolute host directory for persistent data.
DATA_DIR=
# Required: copy the stable CARD name from `aplay -L`, e.g. plughw:CARD=YourCard,DEV=0.
# Do not use numeric card indexes such as hw:1,0.
AUDIO_DEVICE=
DEVICE_NAME=NAS Audio
NETWORK_INTERFACE=
SAMPLE_RATE=48000
OUTPUT_VOLUME=100
ENABLE_AIRPLAY=true
ENABLE_DLNA=true
ENABLE_SPOTIFY=true
ENABLE_MIPLAY=true
# DLNA decoded PCM prebuffer (0 disables); music-first, adds initial delay.
DLNA_BUFFER_MS=1000
# Pulse output route target latency, not an HTTP network buffer.
OUTPUT_BUFFER_MS=200
# ALSA output scheduling: timer (PulseAudio default) or interrupt (fixed small
# hardware queue = OUTPUT_FRAGMENTS x OUTPUT_FRAGMENT_MS). Validate on the target host.
OUTPUT_SCHEDULING=timer
OUTPUT_FRAGMENT_MS=2
OUTPUT_FRAGMENTS=3
# Realtime PulseAudio/desktop receiver within the compose rtprio/nice ulimits.
PULSE_REALTIME=false
# Native backend: keep the muted output awake this long after idle (0 = suspend at once).
OUTPUT_IDLE_SUSPEND_MS=0
DLNA_PORT=49494
AIRPLAY_PORT=7000
SPOTIFY_PORT=24879
MIPLAY_PORT=8899

# Optional Windows VBAN input, mixed with one phone source.
ENABLE_DESKTOP=false
# Required when enabled: the sending computer's LAN IPv4 address.
VBAN_SOURCE_IP=
VBAN_PORT=6980
VBAN_STREAM_NAME=Windows
DESKTOP_BUFFER_MS=50
DESKTOP_PLAYER_MS=30
DESKTOP_JITTER_MS=20
# Optional native receiver; validate on the target host before enabling.
DESKTOP_BACKEND=python
DESKTOP_NATIVE_LATENCY_MS=16
DESKTOP_NATIVE_JITTER_MS=8
DESKTOP_VOLUME=100
DESKTOP_IDLE_MS=500
