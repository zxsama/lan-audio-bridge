# Required: existing dedicated absolute host directory for persistent data.
DATA_DIR=
# Required: copy the stable CARD name from `aplay -L`, e.g. plughw:CARD=YourCard,DEV=0.
# Do not use numeric card indexes such as hw:1,0.
AUDIO_DEVICE=
DEVICE_NAME=NAS Audio
NETWORK_INTERFACE=
SAMPLE_RATE=48000
OUTPUT_VOLUME=100
ENABLE_AIRPLAY=true
ENABLE_DLNA=true
ENABLE_SPOTIFY=true
ENABLE_MIPLAY=true
# DLNA decoded PCM prebuffer (0 disables); music-first, adds initial delay.
DLNA_BUFFER_MS=1000
# Pulse output route target latency, not an HTTP network buffer.
OUTPUT_BUFFER_MS=200
DLNA_PORT=49494
AIRPLAY_PORT=7000
SPOTIFY_PORT=24879
MIPLAY_PORT=8899
