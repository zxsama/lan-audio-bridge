# Required: existing dedicated TrueNAS dataset directory. No default is used.
DATA_DIR=
# Required: copy the stable CARD name from `aplay -L`, e.g. plughw:CARD=YourUSB,DEV=0.
# Do not use numeric card indexes such as hw:1,0.
AUDIO_DEVICE=
DEVICE_NAME=NAS Audio
NETWORK_INTERFACE=
SAMPLE_RATE=48000
OUTPUT_VOLUME=70
ENABLE_AIRPLAY=true
ENABLE_DLNA=true
ENABLE_SPOTIFY=true
DLNA_PORT=49494
AIRPLAY_PORT=7000
SPOTIFY_PORT=24879
